{
  "name": "@knocklabs/javascript",
  "author": "@knocklabs",
  "version": "0.1.0-rc.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:packages": "turbo build --filter=\"./packages/*\"",
    "dev": "turbo dev",
    "dev:next-example": "turbo dev --filter=\"./packages/*\" --filter=nextjs-example",
    "dev:next-app-dir-example": "turbo dev --filter=\"./packages/*\" --filter=nextjs-app-dir-example",
    "dev:packages": "turbo dev --filter=\"./packages/*\"",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "test": "vitest run --config=./vitest/config.ts",
    "test:watch": "vitest run --config=./vitest/config.ts --watch",
    "test:coverage": "vitest run --config=./vitest/config.ts --coverage",
    "test:ci": "vitest run --config=./vitest/config.ts --silent --coverage --reporter=junit --outputFile=test-report.junit.xml",
    "test:integration": "yarn test:integration:react-18 && yarn test:integration:react-19",
    "test:integration:react-18": "./integration/run-integration.sh 18.2.0",
    "test:integration:react-19": "./integration/run-integration.sh 19.1.0",
    "test:integration:runner": "cd ./integration && yarn test:integration && cd ..",
    "type:check": "turbo type:check",
    "release:version": "yarn changeset version && yarn install --mode=update-lockfile",
    "release:publish": "yarn build:packages && yarn workspaces foreach -Rpt --no-private --from '@knocklabs/*' npm publish --access public --tolerate-republish --tag \"$NPM_CONFIG_TAG\" && yarn changeset tag",
    "postinstall": "manypkg check"
  },
  "prettier": "@knocklabs/prettier-config",
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "examples/*",
    "packages/*",
    "integration"
  ],
  "manypkg": {
    "defaultBranch": "main",
    "ignoredRules": [
      "INTERNAL_MISMATCH"
    ]
  },
  "dependenciesMeta": {
    "@swc/core": {
      "built": true
    },
    "esbuild": {
      "built": true
    },
    "sharp": {
      "built": true
    },
    "unrs-resolver": {
      "built": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@knocklabs/eslint-config": "workspace:^",
    "@knocklabs/prettier-config": "workspace:^",
    "@knocklabs/typescript-config": "workspace:^",
    "@manypkg/cli": "^0.25.0",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.5.3",
    "turbo": "^2.9.16",
    "vitest": "^4.1.10"
  },
  "resolutions": {
    "@swc/core": "1.16.20",
    "@ungap/structured-clone": "1.4.0",
    "@xmldom/xmldom": "0.8.15",
    "ajv@npm:^8.0.0": "8.20.0",
    "baseline-browser-mapping": "2.11.34",
    "brace-expansion@npm:^2.0.1": "2.1.7",
    "brace-expansion@npm:^5.0.5": "5.0.12",
    "browserslist": "4.29.5",
    "compression": "1.8.2",
    "fast-uri": "3.1.9",
    "jose": "6.2.13",
    "js-yaml@npm:^4.1.0": "4.3.2",
    "js-yaml@npm:^4.1.1": "4.3.2",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "minimatch@npm:^9.0.0": "9.0.9",
    "minimatch@npm:^9.0.3": "9.0.9",
    "minimatch@npm:^9.0.4": "9.0.9",
    "nanoid": "3.3.20",
    "node-forge": "1.4.2",
    "on-headers": "1.1.0",
    "picomatch@npm:^4.0.2": "4.0.7",
    "picomatch@npm:^4.0.3": "4.0.7",
    "picomatch@npm:^4.0.4": "4.0.7",
    "picomatch@npm:^4.0.5": "4.0.7",
    "seroval": "1.7.2",
    "seroval-plugins": "1.7.2",
    "set-cookie-parser": "2.7.3",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici@npm:^6.23.0": "6.29.1",
    "undici@npm:^7.25.0": "7.30.1",
    "uuid@npm:^7.0.3": "11.1.1",
    "ws@npm:^8.12.1": "8.22.0"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
